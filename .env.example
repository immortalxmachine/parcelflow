# ParcelFlow configuration.
# Copy this file to `.env` and adjust. NEVER commit a real .env (it is git-ignored).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. Default (local, zero-setup) is SQLite in ./data.
# For the Docker Compose / production-like path, use the Postgres URL below.
DATABASE_URL=sqlite:///data/parcelflow.db
# DATABASE_URL=postgresql+psycopg://parcelflow:parcelflow@localhost:5432/parcelflow

# ---------------------------------------------------------------------------
# Blob storage backend: "local" (filesystem) or "azure" (Azurite / Azure Blob)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
# Where the local backend keeps "blobs" (used only when STORAGE_BACKEND=local)
LOCAL_STORAGE_ROOT=data/blob

# Azure Blob settings (used only when STORAGE_BACKEND=azure).
# The connection string below is Azurite's well-known DEV connection string.
# It is a public emulator credential, NOT a secret, and works only against a
# local Azurite instance. Real Azure credentials must go in .env, never here.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_RAW_CONTAINER=raw

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# Number of hubs the dashboard/pipeline expect (informational).
PARCELFLOW_N_HUBS=15

# Downscales stored parcel counts so a full 2-year dataset fits a laptop/CI
# while preserving seasonal shape. 1.0 = full FedEx-like scale (millions of
# rows); 0.02 (default) keeps the demo dataset to a few hundred thousand rows.
VOLUME_SCALE=0.02
